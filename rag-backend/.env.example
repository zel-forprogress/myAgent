# DashScope / Qwen through OpenAI-compatible API
OPENAI_API_KEY=your_dashscope_api_key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v4

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=rag_docs

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/myagent

# Object storage
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=myagent-docs
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false

# Auth seed users
AUTH_SECRET_KEY=dev-secret-key-change-me-please-use-32chars
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123456
SEED_USER_USERNAME=demo
SEED_USER_PASSWORD=demo123456

# Langfuse, optional
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TIMEOUT=30

# Async ingestion queue
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
INGESTION_TASK_MAX_RETRIES=3
INGESTION_TASK_RETRY_DELAY_SECONDS=30

# Rerank, optional
RERANK_ENABLED=false
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=
RERANK_TIMEOUT_SECONDS=30
RERANK_CANDIDATE_MULTIPLIER=4
