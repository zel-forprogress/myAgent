# 完整 Docker Compose 启动使用的环境变量模板。
# 使用前请复制为项目根目录下的 .env。

# DashScope / Qwen，使用 OpenAI-compatible API 协议调用
OPENAI_API_KEY=your_dashscope_api_key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.7-plus
EMBEDDING_MODEL=text-embedding-v4

# Milvus
MILVUS_COLLECTION=rag_docs

# 对象存储
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_BUCKET=myagent-docs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false

# 登录认证与初始化测试账号
AUTH_SECRET_KEY=dev-secret-key-change-me-please-use-32chars
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 允许跨域访问的前端地址，逗号分隔；部署到公网时替换为你的域名
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123456
SEED_USER_USERNAME=demo
SEED_USER_PASSWORD=demo123456

# Langfuse，可选配置
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TIMEOUT=30

# 异步入库队列
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
INGESTION_TASK_MAX_RETRIES=3
INGESTION_TASK_RETRY_DELAY_SECONDS=30

# Rerank，可选；检索测试页可单次启用
RERANK_ENABLED=false
RERANK_MODEL=qwen3-rerank
RERANK_BASE_URL=
RERANK_TIMEOUT_SECONDS=30
RERANK_CANDIDATE_MULTIPLIER=4

# 浏览器访问后端的地址，Next.js 前端会使用它调用 FastAPI
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
